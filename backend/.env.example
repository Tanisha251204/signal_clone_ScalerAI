# Comma-separated list of allowed frontend origins (use * for any)
CORS_ORIGINS=http://localhost:3000
# SQLite for local dev. For a hosted Postgres (Neon etc.) use e.g.
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=sqlite:///./signal.db
UPLOAD_DIR=./uploads
FIXED_OTP=123456
SEED_DEMO_DATA=1
